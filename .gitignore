!/dist/*/windows-x64/wshell-*-windows-x64.zip.sha256
!/dist/*/macos-universal/
!/dist/*/macos-universal/wshell-*-macos-universal.zip
!/dist/*/macos-universal/wshell-*-macos-universal.zip.sha256
!/dist/ipad/*/
!/dist/ipad/*/manifest.json
!/dist/ipad/*/wshell-ipad-*-unsigned.ipa
!/dist/ipad/*/wshell-ipad-*-unsigned.ipa.sha256

# Keep reviewed release artifacts, excluding arbitrary files and runtime data.
/release/**
!/release/README.md
!/release/*/
!/release/*/manifest.json
!/release/*/windows-x64/
!/release/*/windows-x64/wShell.exe
!/release/*/windows-x64/wShell.exe.sha256
!/release/*/windows-x64/wshell-*-windows-x64.zip
!/release/*/windows-x64/wshell-*-windows-x64.zip.sha256
!/release/latest/windows-x64/wshell-windows-x64.zip
!/release/latest/windows-x64/wshell-windows-x64.zip.sha256
!/release/*/macos-universal/
!/release/*/macos-universal/wshell-*-macos-universal.zip
!/release/*/macos-universal/wshell-*-macos-universal.zip.sha256
data/
# Local SSH keys supplied for connection troubleshooting; never distribute.
/resources/
__pycache__/
*.user
*.log
*.dmp

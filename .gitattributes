*.swift text eol=lf
*.resolved text eol=lf
VERSION text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.cjs text eol=lf
*.rc text eol=lf
*.manifest text eol=lf
*.png binary
*.ico binary
*.ttf binary
*.exe binary
*.zip binary
*.ipa binary
*.sha256 text eol=lf

#include <windows.h>
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Wook Shell contributors"
      VALUE "FileDescription", "Wook Shell portable SSH client"
      VALUE "FileVersion", "0.1.0"
      VALUE "InternalName", "WookShell"
      VALUE "LegalCopyright", "Copyright 2026 Wook Shell contributors. MIT License."
      VALUE "OriginalFilename", "WookShell.exe"
      VALUE "ProductName", "Wook Shell"
      VALUE "ProductVersion", "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

#include <windows.h>
#include "../.deps/putty/windows/wshell-terminal.rc"
101 ICON "wshell.ico"
102 RCDATA "branding/wshell-wordmark.png"
103 RCDATA "fonts/JetBrainsMono-Regular.ttf"
104 RCDATA "fonts/JetBrainsMono-Bold.ttf"
105 RCDATA "../build/legal-notices.txt"
106 DIALOGEX 0, 0, 320, 200
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
FONT 11, "JetBrains Mono"
BEGIN
END
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
FILEVERSION 0,4,0,0
PRODUCTVERSION 0,4,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "wShell contributors"
      VALUE "FileDescription", "wShell portable SSH client"
      VALUE "FileVersion", "0.4.0"
      VALUE "InternalName", "wShell"
      VALUE "LegalCopyright", "Copyright 2026 Wook Shell contributors. MIT License."
      VALUE "OriginalFilename", "wShell.exe"
      VALUE "ProductName", "wShell"
      VALUE "ProductVersion", "0.4.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
